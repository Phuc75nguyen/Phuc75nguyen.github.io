---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR } from '../site.config';
---

<BaseLayout title={AUTHOR.name}>
  <div class="flex min-h-[60vh] flex-col items-center justify-center gap-2 text-center">
    <h1 class="text-4xl font-semibold text-(--color-text)">{AUTHOR.name}</h1>
    <p class="text-(--color-text-dim)">{AUTHOR.tagline}</p>
    <p class="mt-4 text-sm text-(--color-text-dim)">
      Trang chủ đầy đủ (Hero, Featured Papers, Gần đây) sẽ hoàn thiện khi có nội dung thật ở Phase 2.
    </p>
  </div>
</BaseLayout>
