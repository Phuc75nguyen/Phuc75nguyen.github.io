---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import Chip from '../../components/ui/Chip.astro';
import DotRating from '../../components/ui/DotRating.astro';
import { getPublished } from '../../lib/collections';

const papers = await getPublished('papers');

const DOMAINS = [
  'LLM & VLM',
  'Computer Vision',
  'Agentic AI',
  'ML & MLOps',
  'OCR & Document AI',
  'Applied AI',
] as const;

const STATUS_LABEL: Record<(typeof papers)[number]['data']['status'], string> = {
  reading: 'Đang đọc',
  analyzed: 'Đã phân tích',
  applied: 'Đã áp dụng',
};
---

<BaseLayout
  title="Papers"
  description="Thư viện phân tích paper AI/ML, kèm phản biện và đánh giá khả năng ứng dụng."
  room="lab"
>
  <header class="mb-8 flex flex-col gap-2">
    <h1 class="text-4xl font-semibold text-(--color-text)">Thư viện Papers</h1>
    <p class="max-w-(--breakpoint-md) text-(--color-text-dim)">
      Mỗi bài ở đây là một lần mổ xẻ, không phải bản tóm tắt — kèm phần Phản biện và đánh giá khả
      năng ứng dụng thực tế.
    </p>
  </header>

  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div
      id="domain-filters"
      class="flex flex-wrap gap-2"
      role="group"
      aria-label="Lọc theo lĩnh vực"
    >
      <Chip value="all" active={true} class="js-filter-chip">
        Tất cả
      </Chip>
      {DOMAINS.map((domain) => (
        <Chip value={domain} class="js-filter-chip">
          {domain}
        </Chip>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <label
        for="sort-select"
        class="font-mono text-xs uppercase tracking-wide text-(--color-text-dim)"
      >
        Sắp xếp
      </label>
      <select
        id="sort-select"
        class="rounded-md border border-(--color-border) bg-(--color-surface) px-3 py-1.5 text-sm text-(--color-text)"
      >
        <option value="date">Mới nhất</option>
        <option value="year">Năm paper</option>
        <option value="difficulty">Độ khó</option>
        <option value="impact">Mức ảnh hưởng</option>
      </select>

      <div
        class="flex rounded-md border border-(--color-border)"
        role="group"
        aria-label="Chế độ xem"
      >
        <button
          type="button"
          id="view-card-btn"
          aria-pressed="true"
          class="rounded-l-md px-3 py-1.5 text-sm text-(--color-text) bg-(--color-surface)"
        >
          Card
        </button>
        <button
          type="button"
          id="view-table-btn"
          aria-pressed="false"
          class="rounded-r-md px-3 py-1.5 text-sm text-(--color-text-dim)"
        >
          Bảng
        </button>
      </div>
    </div>
  </div>

  <noscript>
    <p class="mb-6 rounded-(--radius-card) border border-(--color-border) bg-(--color-surface) p-4 text-sm text-(--color-text-dim)">
      JavaScript đang tắt — danh sách dưới đây hiển thị toàn bộ, chưa lọc hay sắp xếp lại được.
    </p>
  </noscript>

  {papers.length === 0 ? (
    <p class="text-(--color-text-dim)">Chưa có bài phân tích nào.</p>
  ) : (
    <Fragment>
      <div id="card-view" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {papers.map((entry) => (
          <div
            class="js-paper-item"
            data-reveal
            data-domain={entry.data.domain}
            data-year={entry.data.year}
            data-difficulty={entry.data.difficulty}
            data-impact={entry.data.impact}
            data-date={entry.data.publishDate.getTime()}
          >
            <Card href={`/papers/${entry.id}`} class="flex h-full flex-col gap-3">
              <p class="font-mono text-xs uppercase tracking-wide text-(--color-text-dim)">
                {entry.data.paperTitle} · {entry.data.venue ? `${entry.data.venue} ` : ''}
                {entry.data.year}
              </p>
              <h2 class="text-lg font-semibold text-(--color-text)">{entry.data.title}</h2>
              <p class="flex-1 text-sm text-(--color-text-dim)">{entry.data.tldr}</p>
              <div class="flex flex-wrap items-center gap-2">
                <Badge tone="accent">{entry.data.domain}</Badge>
                <Badge tone="muted">{STATUS_LABEL[entry.data.status]}</Badge>
              </div>
              <DotRating label="Độ khó" value={entry.data.difficulty} />
            </Card>
          </div>
        ))}
      </div>

      <div id="table-view" class="hidden overflow-x-auto">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-(--color-border) text-left font-mono text-xs uppercase tracking-wide text-(--color-text-dim)">
              <th class="py-2 pr-4">Paper</th>
              <th class="py-2 pr-4">Domain</th>
              <th class="py-2 pr-4">Year</th>
              <th class="py-2 pr-4">Difficulty</th>
              <th class="py-2 pr-4">Impact</th>
              <th class="py-2 pr-4">Status</th>
            </tr>
          </thead>
          <tbody>
            {papers.map((entry) => (
              <tr
                class="js-paper-item border-b border-(--color-border)"
                data-domain={entry.data.domain}
                data-year={entry.data.year}
                data-difficulty={entry.data.difficulty}
                data-impact={entry.data.impact}
                data-date={entry.data.publishDate.getTime()}
              >
                <td class="py-2 pr-4">
                  <a
                    href={`/papers/${entry.id}`}
                    class="text-(--color-text) hover:text-(--color-accent)"
                  >
                    {entry.data.title}
                  </a>
                </td>
                <td class="py-2 pr-4 text-(--color-text-dim)">{entry.data.domain}</td>
                <td class="py-2 pr-4 text-(--color-text-dim)">{entry.data.year}</td>
                <td class="py-2 pr-4 text-(--color-text-dim)">{entry.data.difficulty}/5</td>
                <td class="py-2 pr-4 text-(--color-text-dim)">{entry.data.impact}/5</td>
                <td class="py-2 pr-4 text-(--color-text-dim)">{STATUS_LABEL[entry.data.status]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Fragment>
  )}

  <p id="empty-state" class="hidden text-(--color-text-dim)">
    Không có paper nào khớp bộ lọc.
  </p>
</BaseLayout>

<script>
  const CHIP_ACTIVE = [
    'border-(--color-accent)',
    'bg-(--color-accent)/15',
    'text-(--color-accent)',
  ];
  const CHIP_INACTIVE = ['border-(--color-border)', 'text-(--color-text-dim)'];

  const params = new URLSearchParams(window.location.search);
  let currentDomain = params.get('domain') ?? 'all';
  let currentSort = params.get('sort') ?? 'date';

  const chips = document.querySelectorAll<HTMLButtonElement>('.js-filter-chip');
  const items = document.querySelectorAll<HTMLElement>('.js-paper-item');
  const emptyState = document.getElementById('empty-state');
  const cardView = document.getElementById('card-view');
  const tableView = document.getElementById('table-view');
  const viewCardBtn = document.getElementById('view-card-btn');
  const viewTableBtn = document.getElementById('view-table-btn');
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;

  function syncUrl() {
    const next = new URLSearchParams();
    if (currentDomain !== 'all') next.set('domain', currentDomain);
    if (currentSort !== 'date') next.set('sort', currentSort);
    const query = next.toString();
    history.replaceState(null, '', query ? `?${query}` : window.location.pathname);
  }

  function applyFilter() {
    let visibleCount = 0;
    items.forEach((item) => {
      const matches = currentDomain === 'all' || item.dataset.domain === currentDomain;
      item.classList.toggle('hidden', !matches);
      if (matches) visibleCount += 1;
    });
    emptyState?.classList.toggle('hidden', visibleCount > 0);

    chips.forEach((chip) => {
      const isActive = chip.dataset.value === currentDomain;
      chip.setAttribute('aria-pressed', String(isActive));
      CHIP_ACTIVE.forEach((cls) => chip.classList.toggle(cls, isActive));
      CHIP_INACTIVE.forEach((cls) => chip.classList.toggle(cls, !isActive));
    });
  }

  function applySort() {
    for (const container of [cardView, tableView]) {
      if (!container) continue;
      const rows = Array.from(container.querySelectorAll<HTMLElement>('.js-paper-item'));
      rows.sort((a, b) => {
        switch (currentSort) {
          case 'year':
            return Number(b.dataset.year) - Number(a.dataset.year);
          case 'difficulty':
            return Number(b.dataset.difficulty) - Number(a.dataset.difficulty);
          case 'impact':
            return Number(b.dataset.impact) - Number(a.dataset.impact);
          default:
            return Number(b.dataset.date) - Number(a.dataset.date);
        }
      });
      const target = container.querySelector('tbody') ?? container;
      rows.forEach((row) => target.appendChild(row));
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      currentDomain = chip.dataset.value ?? 'all';
      applyFilter();
      syncUrl();
    });
  });

  sortSelect?.addEventListener('change', () => {
    currentSort = sortSelect.value;
    applySort();
    syncUrl();
  });

  viewCardBtn?.addEventListener('click', () => {
    cardView?.classList.remove('hidden');
    tableView?.classList.add('hidden');
    viewCardBtn.setAttribute('aria-pressed', 'true');
    viewTableBtn?.setAttribute('aria-pressed', 'false');
    viewCardBtn.classList.add('bg-(--color-surface)', 'text-(--color-text)');
    viewTableBtn?.classList.remove('bg-(--color-surface)', 'text-(--color-text)');
  });

  viewTableBtn?.addEventListener('click', () => {
    tableView?.classList.remove('hidden');
    cardView?.classList.add('hidden');
    viewTableBtn.setAttribute('aria-pressed', 'true');
    viewCardBtn?.setAttribute('aria-pressed', 'false');
    viewTableBtn.classList.add('bg-(--color-surface)', 'text-(--color-text)');
    viewCardBtn?.classList.remove('bg-(--color-surface)', 'text-(--color-text)');
  });

  if (sortSelect) sortSelect.value = currentSort;
  applyFilter();
  applySort();
</script>
