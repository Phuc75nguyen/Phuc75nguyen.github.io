---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublished } from '../../lib/collections';
import { extractPoemPreviewLines } from '../../lib/poem-preview';

const poems = await getPublished('poems');

interface PoemCard {
  id: string;
  title: string;
  form: string;
  previewLines: string[];
}

const grouped = new Map<string | undefined, PoemCard[]>();
for (const entry of poems) {
  const card: PoemCard = {
    id: entry.id,
    title: entry.data.title,
    form: entry.data.form,
    previewLines: extractPoemPreviewLines(entry.body ?? ''),
  };
  const key = entry.data.collection;
  const bucket = grouped.get(key) ?? [];
  bucket.push(card);
  grouped.set(key, bucket);
}
---

<BaseLayout title="Thơ" description="Thơ — lục bát, tự do, và những thể khác." room="hien">
  <header class="mx-auto mb-10 max-w-3xl">
    <h1 class="font-serif text-4xl text-(--color-text)">Thơ</h1>
  </header>

  {poems.length === 0 ? (
    <p class="mx-auto max-w-3xl text-center text-(--color-text-dim)">Chưa có bài thơ nào.</p>
  ) : (
    <div class="mx-auto flex max-w-3xl flex-col gap-10">
      {[...grouped.entries()].map(([collection, cards]) => (
        <section>
          {collection && (
            <h2 class="mb-4 font-serif text-xl text-(--color-text-dim)">{collection}</h2>
          )}
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            {cards.map((card) => (
              <a
                href={`/poems/${card.id}`}
                data-reveal
                class="group flex flex-col gap-2 border-b border-(--color-border) pb-6"
              >
                <span class="text-sm text-(--color-text-dim)">{card.form}</span>
                <span class="font-serif text-xl text-(--color-text) group-hover:text-(--color-accent)">
                  {card.title}
                </span>
                {card.previewLines.length > 0 && (
                  <p class="whitespace-pre-line font-serif text-(--color-text-dim)">
                    {card.previewLines.join('\n')}
                  </p>
                )}
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  )}
</BaseLayout>
