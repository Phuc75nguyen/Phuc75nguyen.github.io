---
import katex from 'katex';
import BaseLayout from '../layouts/BaseLayout.astro';

// Bang ky hieu toan dung chung toan site (BLUEPRINT Muc 6.5) - moi paper deu
// co the tro ve day thay vi giai thich lai tu dau. Day la trang .astro thuan
// (khong phai content collection), nen render KaTeX truc tiep bang ham
// renderToString cua chinh package katex da duyet o Muc 3.1, khong qua
// remark/rehype (pipeline do chi ap dung cho .mdx).
function tex(source: string): string {
  return katex.renderToString(source, { throwOnError: false, displayMode: false });
}

interface Entry {
  symbol: string;
  name: string;
  description: string;
}
interface Group {
  title: string;
  entries: Entry[];
}

const GROUPS: Group[] = [
  {
    title: 'Đại số tuyến tính',
    entries: [
      { symbol: tex('\\mathbf{x}'), name: 'Vector', description: 'Một vector, thường là vector đặc trưng (feature vector) của một mẫu dữ liệu.' },
      { symbol: tex('\\mathbf{X}'), name: 'Ma trận', description: 'Một ma trận, thường là ma trận dữ liệu kích thước N×D (N mẫu, D chiều).' },
      { symbol: tex('x_i'), name: 'Phần tử thứ i', description: 'Phần tử thứ i của vector x, hoặc mẫu dữ liệu thứ i trong tập huấn luyện.' },
      { symbol: tex('\\mathbb{R}^d'), name: 'Không gian số thực d chiều', description: 'Tập hợp mọi vector số thực có d chiều — miền giá trị thường gặp của embedding.' },
      { symbol: tex('\\|\\mathbf{x}\\|_2'), name: 'Chuẩn Euclid (L2 norm)', description: 'Độ dài vector x theo khoảng cách Euclid — căn bậc hai tổng bình phương các phần tử.' },
      { symbol: tex('\\odot'), name: 'Nhân theo phần tử', description: 'Phép nhân Hadamard — nhân từng phần tử tương ứng của hai vector/ma trận cùng kích thước.' },
    ],
  },
  {
    title: 'Xác suất & thống kê',
    entries: [
      { symbol: tex('\\mathbb{E}[X]'), name: 'Kỳ vọng', description: 'Giá trị kỳ vọng (expectation) của biến ngẫu nhiên X — trung bình có trọng số theo xác suất.' },
      { symbol: tex('\\text{Var}(X)'), name: 'Phương sai', description: 'Độ phân tán của biến ngẫu nhiên X quanh giá trị kỳ vọng của nó.' },
      { symbol: tex('P(A \\mid B)'), name: 'Xác suất có điều kiện', description: 'Xác suất xảy ra A, biết rằng B đã xảy ra.' },
      { symbol: tex('\\mathcal{N}(\\mu, \\sigma^2)'), name: 'Phân phối chuẩn', description: 'Phân phối Gaussian với trung bình μ và phương sai σ² — phân phối phổ biến nhất trong ML.' },
    ],
  },
  {
    title: 'Tối ưu & huấn luyện mô hình',
    entries: [
      { symbol: tex('\\theta'), name: 'Tham số mô hình', description: 'Toàn bộ trọng số (weights) mà mô hình học được trong quá trình huấn luyện.' },
      { symbol: tex('\\mathcal{L}'), name: 'Hàm mất mát (loss)', description: 'Hàm đo độ sai lệch giữa dự đoán và nhãn thật — mục tiêu tối thiểu hóa khi huấn luyện.' },
      { symbol: tex('\\nabla_\\theta \\mathcal{L}'), name: 'Gradient của loss', description: 'Đạo hàm của hàm mất mát theo tham số θ — hướng cập nhật trong gradient descent.' },
      { symbol: tex('\\hat{y}'), name: 'Giá trị dự đoán', description: 'Đầu ra mô hình dự đoán, để phân biệt với nhãn thật y.' },
      { symbol: tex('\\arg\\max_x f(x)'), name: 'Arg max', description: 'Giá trị x làm cho f(x) đạt lớn nhất — ví dụ: nhãn có xác suất cao nhất.' },
      { symbol: tex('\\mathbb{1}[\\cdot]'), name: 'Hàm chỉ báo (indicator)', description: 'Bằng 1 nếu điều kiện trong ngoặc đúng, bằng 0 nếu sai.' },
    ],
  },
  {
    title: 'Hàm thường gặp trong paper',
    entries: [
      { symbol: tex('\\sigma(\\cdot)'), name: 'Sigmoid', description: 'Hàm nén giá trị bất kỳ về khoảng (0, 1) — thường dùng cho bài toán phân loại nhị phân.' },
      { symbol: tex('\\text{softmax}(\\cdot)'), name: 'Softmax', description: 'Chuẩn hóa một vector số thực thành phân phối xác suất (tổng bằng 1).' },
      { symbol: tex('d_k'), name: 'Số chiều key/query', description: 'Ký hiệu quen thuộc trong các paper về attention (vd. Attention Is All You Need) — số chiều của vector key/query.' },
      { symbol: tex('\\propto'), name: 'Tỉ lệ thuận', description: 'A ∝ B nghĩa là A bằng B nhân với một hằng số nào đó — dùng khi không cần quan tâm hệ số chuẩn hóa.' },
    ],
  },
];
---

<BaseLayout
  title="Bảng ký hiệu toán"
  description="Ký hiệu toán học dùng chung cho mọi bài phân tích paper trên site."
  room="lab"
>
  <header class="mb-8 max-w-3xl">
    <h1 class="text-4xl font-semibold text-(--color-text)">Bảng ký hiệu toán</h1>
    <p class="mt-2 text-(--color-text-dim)">
      Ký hiệu dùng chung trong mọi bài phân tích trên site — viết một lần, dùng mãi. Nếu một bài
      dùng ký hiệu nào không có ở đây, tra cứu trực tiếp trong bài đó.
    </p>
  </header>

  <div class="flex flex-col gap-10">
    {
      GROUPS.map((group) => (
        <section>
          <h2 class="mb-4 text-xl font-semibold text-(--color-text)">{group.title}</h2>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="border-b border-(--color-border) text-left font-mono text-xs uppercase tracking-wide text-(--color-text-dim)">
                  <th class="py-2 pr-4">Ký hiệu</th>
                  <th class="py-2 pr-4">Tên</th>
                  <th class="py-2 pr-4">Mô tả</th>
                </tr>
              </thead>
              <tbody>
                {group.entries.map((entry) => (
                  <tr class="border-b border-(--color-border)">
                    <td class="py-2 pr-4" set:html={entry.symbol} />
                    <td class="py-2 pr-4 whitespace-nowrap text-(--color-text)">{entry.name}</td>
                    <td class="py-2 pr-4 text-(--color-text-dim)">{entry.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
