---
import { getCollection, render } from 'astro:content';
import EssayLayout from '../../layouts/EssayLayout.astro';
import { estimateReadingTime } from '../../lib/reading-time';
import { isPublishable } from '../../lib/collections';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => isPublishable(data.draft));
  return essays.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const readingMinutes = estimateReadingTime(entry.body ?? '');
---

<EssayLayout id={entry.id} essay={entry.data} readingMinutes={readingMinutes}>
  <Content />
</EssayLayout>
