---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublished, type ContentType } from '../lib/collections';

const TYPE_LABEL: Record<ContentType, string> = {
  papers: 'Paper',
  notes: 'Note',
  essays: 'Essay',
  poems: 'Thơ',
};
const TYPE_PATH: Record<ContentType, string> = {
  papers: '/papers',
  notes: '/notes',
  essays: '/essays',
  poems: '/poems',
};
const MONTH_NAMES = [
  'Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6',
  'Tháng 7', 'Tháng 8', 'Tháng 9', 'Tháng 10', 'Tháng 11', 'Tháng 12',
];

interface ArchiveItem {
  title: string;
  href: string;
  type: ContentType;
  date: Date;
}

const types: ContentType[] = ['papers', 'notes', 'essays', 'poems'];
const allEntries: ArchiveItem[] = (
  await Promise.all(
    types.map(async (type) => {
      const entries = await getPublished(type);
      return entries.map(
        (entry): ArchiveItem => ({
          title: entry.data.title,
          href: `${TYPE_PATH[type]}/${entry.id}`,
          type,
          date: entry.data.publishDate,
        }),
      );
    }),
  )
).flat();

allEntries.sort((a, b) => b.date.valueOf() - a.date.valueOf());

interface MonthGroup {
  month: number;
  items: ArchiveItem[];
}
interface YearGroup {
  year: number;
  months: MonthGroup[];
}

const years: YearGroup[] = [];
for (const entry of allEntries) {
  const year = entry.date.getFullYear();
  const month = entry.date.getMonth();

  let yearGroup = years.find((y) => y.year === year);
  if (!yearGroup) {
    yearGroup = { year, months: [] };
    years.push(yearGroup);
  }
  let monthGroup = yearGroup.months.find((m) => m.month === month);
  if (!monthGroup) {
    monthGroup = { month, items: [] };
    yearGroup.months.push(monthGroup);
  }
  monthGroup.items.push(entry);
}
---

<BaseLayout title="Archive" description="Toàn bộ nội dung, nhóm theo năm và tháng." room="lab">
  <header class="mb-8">
    <h1 class="text-4xl font-semibold text-(--color-text)">Archive</h1>
  </header>

  {
    years.length === 0 ? (
      <p class="text-(--color-text-dim)">Chưa có nội dung nào.</p>
    ) : (
      <div class="flex flex-col gap-10">
        {years.map((yearGroup) => (
          <section>
            <h2 class="mb-4 text-2xl font-semibold text-(--color-text)">{yearGroup.year}</h2>
            <div class="flex flex-col gap-6">
              {yearGroup.months.map((monthGroup) => (
                <div>
                  <p class="mb-2 font-mono text-xs uppercase tracking-wide text-(--color-text-dim)">
                    {MONTH_NAMES[monthGroup.month]}
                  </p>
                  <ul class="flex flex-col gap-1.5 border-l border-(--color-border) pl-4">
                    {monthGroup.items.map((item) => (
                      <li class="flex items-baseline gap-3 text-sm">
                        <span class="font-mono text-xs text-(--color-text-dim)">
                          {TYPE_LABEL[item.type]}
                        </span>
                        <a href={item.href} class="text-(--color-text) hover:text-(--color-accent)">
                          {item.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>
