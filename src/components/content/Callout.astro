---
import { Icon } from 'astro-icon/components';

interface Props {
  /** "critique" = block "Phan bien", "application" = block "Ung dung thuc te" (BLUEPRINT Muc 6.3). */
  type?: 'note' | 'warning' | 'critique' | 'application';
}

const { type = 'note' } = Astro.props;

const CONFIG: Record<
  NonNullable<Props['type']>,
  { icon: string; label: string; border: string }
> = {
  note: { icon: 'lucide:info', label: 'Ghi chú', border: 'border-l-(--color-accent-2)' },
  warning: { icon: 'lucide:alert-triangle', label: 'Lưu ý', border: 'border-l-(--color-accent)' },
  critique: {
    icon: 'lucide:alert-triangle',
    label: 'Phản biện',
    border: 'border-l-(--color-accent)',
  },
  application: {
    icon: 'lucide:cog',
    label: 'Ứng dụng thực tế',
    border: 'border-l-(--color-accent-2)',
  },
};

const { icon, label, border } = CONFIG[type];
---

<div class:list={['my-6 rounded-(--radius-card) border-l-4 bg-(--color-surface-2) p-5', border]}>
  <p class="mb-2 flex items-center gap-2 font-mono text-xs uppercase tracking-wide text-(--color-text-dim)">
    <Icon name={icon} class="size-4" aria-hidden="true" />
    {label}
  </p>
  <div class="text-(--color-text) [&>:last-child]:mb-0">
    <slot />
  </div>
</div>
