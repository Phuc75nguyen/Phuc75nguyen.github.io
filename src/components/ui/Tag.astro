---
import { slugify } from '../../lib/slugify';

interface Props {
  tag: string;
  class?: string;
}

const { tag, class: className } = Astro.props;
const href = `/tags/${slugify(tag)}`;
---

<a
  href={href}
  class:list={[
    'tag-pill inline-flex items-center rounded-full border border-(--color-border) px-2.5 py-1',
    'font-mono text-xs text-(--color-text-dim)',
    'motion-safe:transition-colors motion-safe:duration-150',
    'hover:border-(--color-accent)/40 hover:text-(--color-accent)',
    className,
  ]}
>
  #{tag}
</a>
