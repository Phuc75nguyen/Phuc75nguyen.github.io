---
interface Props {
  value: number;
  max?: number;
  label: string;
  class?: string;
}

const { value, max = 5, label, class: className } = Astro.props;
const dots = Array.from({ length: max }, (_, i) => i < value);
---

<span
  class:list={['inline-flex items-center gap-1.5', className]}
  role="img"
  aria-label={`${label}: ${value}/${max}`}
>
  <span class="font-mono text-xs uppercase tracking-wide text-(--color-text-dim)">{label}</span>
  <span aria-hidden="true" class="flex gap-0.5">
    {dots.map((filled) => (
      <span
        class:list={[
          'size-1.5 rounded-full',
          filled ? 'bg-(--color-accent)' : 'bg-(--color-border)',
        ]}
      />
    ))}
  </span>
</span>
